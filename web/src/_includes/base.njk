<!doctype html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta name="google-site-verification" content="gYJ3zgKZ2-01-9B35CzUEbnbczUlwWyzOFFRFaKW3fg">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" href="{{ '/assets/brand/favicon.svg' | url }}" type="image/svg+xml">
<link rel="icon" href="{{ '/assets/brand/favicon-32.png' | url }}" sizes="32x32" type="image/png">
<link rel="icon" href="{{ '/assets/brand/favicon-16.png' | url }}" sizes="16x16" type="image/png">
<link rel="shortcut icon" href="{{ '/assets/brand/favicon.ico' | url }}">
<link rel="apple-touch-icon" href="{{ '/assets/brand/apple-touch-icon.png' | url }}">
<meta name="theme-color" content="#774bad">

<meta property="og:type" content="website">
<meta property="og:site_name" content="FIT4WOMEN">
<meta property="og:locale" content="cs_CZ">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ (ogImage or '/assets/images/og-share.jpg') | url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site.url }}{{ (ogImage or '/assets/images/og-share.jpg') | url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700;800&display=swap">
<link rel="stylesheet" href="{{ '/assets/styles.css' | url }}">
<script defer src="{{ '/assets/site.js' | url }}"></script>
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "ExerciseGym",
  "@id": site.url + "/#business",
  "name": "FIT4WOMEN",
  "url": site.url,
  "description": description,
  "image": site.url + ('/assets/images/og-share.jpg' | url),
  "telephone": site.contact.phone,
  "email": site.contact.email,
  "priceRange": "130–600 Kč",
  "openingHoursSpecification": openingHours,
  "sameAs": [site.contact.instagram, site.contact.facebook, site.contact.googleMaps],
  "founder": {
    "@type": "Person",
    "name": site.contact.name,
    "jobTitle": site.contact.role
  },
  "location": [
    {
      "@type": "Place",
      "name": "Újezd nad Lesy",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "ul. Polesná",
        "addressLocality": "Praha - Újezd nad Lesy",
        "addressCountry": "CZ"
      }
    },
    {
      "@type": "Place",
      "name": "Koloděje",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "V Lipách 135",
        "addressLocality": "Praha - Koloděje",
        "addressCountry": "CZ"
      }
    }
  ]
} | dump | safe }}
</script>
</head>
<body>

<a class="skip-link" href="#main">Přeskočit na obsah</a>

{% include "header.njk" %}

<main id="main">
{{ content | safe }}
</main>

{% include "footer.njk" %}

</body>
</html>
